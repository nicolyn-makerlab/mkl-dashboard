# --- Notion ---
# Create at https://www.notion.so/my-integrations, then share your
# "Companies & Clients CRM" page (and the Tasks database) with it.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Data source IDs (already filled in from your workspace - only change
# these if the databases get moved, renamed, or recreated in Notion).
NOTION_COMPANIES_DS=3c77f4cc-dcfc-8088-9e44-000ba802b165
NOTION_CLIENTS_CRM_DS=f5a7f4cc-dcfc-821c-97e5-07ac2f6d750a
NOTION_TASKS_DS=3c77f4cc-dcfc-8094-89fb-000bedf54690

# Your name exactly as it appears in the Tasks "Owner" select field
TASK_OWNER_NAME=Me

# Company page names to exclude from the dashboard - these exist in the
# Companies database but aren't real clients (internal docs, etc).
# Comma separated, must match the Notion page title exactly.
EXCLUDE_COMPANIES=MKL Leadership & PM docs

# --- Google Calendar ---
# Create an OAuth Desktop App client at https://console.cloud.google.com
# (APIs & Services > Credentials), enable the Calendar API, download the
# JSON, save it in this folder as google-credentials.json, then run
# "npm run auth" once to complete the consent flow.
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
GOOGLE_TOKEN_PATH=./google-token.json

# --- Dashboard rules (from your answers) ---
TASK_LOOKAHEAD_DAYS=7
MEETING_LOOKAHEAD_DAYS=14
LAST_CONTACT_YELLOW_DAYS=14
LAST_CONTACT_RED_DAYS=30

PORT=3000
